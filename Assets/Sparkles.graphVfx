            Code:
              ClassType1: TEXT
              String: |-
                input_bool  SizeMode;
                input_float  SizeMin;
                input_float  SizeMax;
                input_float  SizeMul;
                
                void main()
                {
                	float rand = system.getParticleRandomFloat(true, true, true, 20.0);
                	rand = mix(SizeMin * SizeMul, SizeMax * SizeMul, rand);
                	float localSize = length(system.getAABBMaxLocal() - system.getAABBMinLocal());
                	system.setParticleSize(mix(rand, rand/localSize, SizeMode));
                }
