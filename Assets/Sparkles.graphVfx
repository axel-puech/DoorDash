        Node4:
          DependencyIndex: 62
          LevelID: 9
          NodeCount: 0
          NodeType: 1
          Ports:
            Area:
              Connection0:
                NodeLevelID: 269
                PortID: Value
              Variable: 0.0
            Code:
              ClassType1: TEXT
              String: |-
                input_float DragCoefficient;
                input_float Density;
                input_float Area;
                
                void main()
                {
                	vec3 vel = system.getParticleVelocity();
                	float mass = system.getParticleMass();
                
                	vec3 dragForce = -vel * length(vel) * DragCoefficient * Density * Area * 0.5;
                	vec3 limit = abs(vel * mass) / system.getTimeDelta();
                
                	dragForce = clamp(dragForce, -limit, limit);
                
                	vec3 force = system.getParticleForce() + dragForce;
                
                	system.setParticleForce(force);
                }
