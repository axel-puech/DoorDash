        Node5:
          DependencyIndex: 55
          LevelID: 73
          NodeCount: 0
          NodeType: 1
          Ports:
            AlphaMax:
              Connection0:
                NodeLevelID: 17
                PortID: Value
              Variable: 0.0
            AlphaMin:
              Connection0:
                NodeLevelID: 4
                PortID: Value
              Variable: 0.0
            Code:
              ClassType1: TEXT
              String: |
                input_float AlphaMin;
                input_float AlphaMax;
                input_float FadeInTime;
                input_float FadeOutTime;
                
                float attackDecay(float controlValue, float attackTime, float decayTime) {
                	float rise = clamp(controlValue/attackTime, 0.0, 1.0);
                	float fall = clamp((1.0 - controlValue)/decayTime, 0.0, 1.0);
                	return rise * fall;
                }
                
                void main()
                {
                	float pAge = system.getParticleAgeRatio();
                	float pLife = system.getParticleLife();
                	vec4 pColor = system.getParticleColor();
                
                	float ratio = attackDecay(pAge, FadeInTime/pLife, FadeOutTime/pLife);
                	pColor.a = mix(AlphaMin, AlphaMax, ratio);
                
                	system.setParticleColor(pColor);
                }

            CustomCodeNodeAsset:
              ClassType1: REFUID
              String: ""
            Description:
              ClassType1: TEXT
              String: ""
            Examples:
              ItemIndex: 0
              ItemList: "Custom : System Built-In Values/Functions"
            FadeInTime:
              Connection0:
                NodeLevelID: 185
                PortID: Value
              Variable: 0.0
            FadeOutTime:
              Connection0:
                NodeLevelID: 188
                PortID: Value
              Variable: 0.0
            ID:
              Variable: 73
            Locked:
              Variable: false
            ParticleIn:
              ClassType2: PARTICLE
              Connection0:
                NodeLevelID: 3
                PortID: Value
            ParticleOut:
