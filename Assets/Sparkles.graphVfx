          Title1: Float Import
          Title2: Volume Fill
        Node6:
          DependencyIndex: 10
          LevelID: 42
          NodeCount: 0
          NodeType: 1
          Ports:
            Center:
              Connection0:
                NodeLevelID: 38
                PortID: Value
              Variable: [0.0, 0.0, 0.0]
            Code:
              ClassType1: TEXT
              String: |+
                input_int SphereType;
                input_float Radius;
                input_vec3 Scale;
                input_vec3 Center;
                input_float VolumeFill;
                
                void main()
                {
                	vec3 rand1 = system.getParticleRandomVec3(true, true, true, 0.0);
                	vec3 rand2 = system.getParticleRandomVec3(true, true, true, 150.0);
                
                	float fill = pow(1.0 - VolumeFill, 3.0);
                	rand1 = mix(vec3(fill), vec3(1.0), rand1);
                	rand1 = sqrt(rand1);
                
                	rand2 = mix(vec3(-1.0), vec3(1.0), rand2);
                	rand2 /= length(rand2 + 0.0001);
                
                	vec3 pos = rand1 * rand2 * Scale * Radius;
                
                	// Hemispheres
                	if (SphereType == 1) {
                		pos.x = abs(pos.x);
                	}
                	else if (SphereType == 2) {
                		pos.y = abs(pos.y);
                	}
                	else if (SphereType == 3) {
                		pos.z = abs(pos.z);
                	}
                
                	pos += Center;
                
                	system.setParticlePosition(pos);
                }
                
                
            CustomCodeNodeAsset:
              ClassType1: REFUID
              String: ""
            Description:
              ClassType1: TEXT
              String: ""
            Examples:
              ItemIndex: 0
              ItemList: "Custom : System Built-In Values/Functions"
