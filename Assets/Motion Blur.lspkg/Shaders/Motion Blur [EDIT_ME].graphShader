    Node15:
      DependencyIndex: 15
      LevelID: 5
      NodeCount: 0
      NodeType: 1
      Ports:
        Angle:
          Connection0:
            NodeLevelID: 0
            PortID: Output
          Variable: 0.0
        Code:
          ClassType1: TEXT
          String: |-
            input_texture_2d Texture;
            input_float Angle;
            input_float Factor;
            input_float Samples;
            input_bool Fit;
            output_vec4 Result;
            
            global_float PI;
            
            void main()
            {
            
                vec2 iResolution = Texture.textureSize();
                vec2 fragCoord = iResolution * system.getScreenUVCoord();
                vec2 uv = fragCoord / iResolution;
                vec2 tex = 1.0 / iResolution;
            
                PI = system.pi();
                float rad = Angle * (PI / 180.0);
                vec2 scaleCenter = vec2(0.5);
            
                vec2 line = vec2(cos(rad), sin(rad)) * 30.0 * Factor;
                float dist = 1.0 / Samples;
                vec3 col = vec3(0.0);
            
                vec2 calculateZoom = vec2(abs((line * tex).x), abs((line * tex).y));
                float zoom = (calculateZoom.x > calculateZoom.y) ? (calculateZoom.x / 2.0) : (calculateZoom.y / 2.0);
                    
                float motion = -0.5;
                for(float i = 0.0; i < Samples; i ++) {
            
                    vec2 coord = uv + motion * line * tex;
            
                    if(Fit)
                        coord = (coord - scaleCenter) * (1.0 - zoom - (0.015 * Factor)) + scaleCenter;
            
                    col += Texture.sample(coord).rgb;
                    motion += dist;
                }
                
                col /= Samples;
            
                Result = vec4(col, 1.0);
            }
        Description:
          ClassType1: TEXT
          String: |-
            Motion Blur by Luka Lan Gabriel
            lukalangabriel.com
            social: @lukalangabriel
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        Factor:
          Connection0:
            NodeLevelID: 18
            PortID: Output
          Variable: 0.0
        Fit:
          Connection0:
            NodeLevelID: 9
            PortID: Result
          Variable: 0.0
        ID:
          Variable: 5
        Locked:
          Variable: false
        Result:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
        Samples:
          Connection0:
            NodeLevelID: 13
            PortID: Result
          Variable: 0.0
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Texture:
          ClassType2: TEXTURE_OBJECT_2D
          Connection0:
            NodeLevelID: 17
            PortID: Texture
        Title:
